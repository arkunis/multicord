# Sans URL, Multicord utilise SQLite dans ./data/multicord.db.
# PostgreSQL local ou Supabase : URL serveur uniquement, jamais dans le client.
# DATABASE_URL=postgresql://multicord:multicord@localhost:5432/multicord
# Aiven : télécharger la CA depuis la console et la placer dans data/.
# Validation TLS complète, sans désactiver la vérification des certificats.
# DATABASE_SSL_CA_FILE=data/aiven-ca.pem
# Limite applicative ; laisse des connexions disponibles pour la console.
DATABASE_POOL_MAX=5
PORT=3000
# Production : origine HTTPS de l'application
# APP_ORIGIN=https://multicord.example.com
# E-mails locaux uniquement (sans APP_ORIGIN public) : fichiers privés data/mail.
MAIL_TRANSPORT=file
# Pour envoyer réellement les e-mails, configurer SMTP et une origine HTTPS :
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=multicord
# SMTP_PASSWORD=change-me
# MAIL_FROM=Multicord <bonjour@example.com>
# Serveur TURN facultatif, recommandé entre réseaux différents
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=multicord
# TURN_CREDENTIAL=change-me
