# Copier ce fichier en .env (jamais publié) puis le compléter.

# Adresse publique du serveur, sans https://
#  - avec un nom de domaine : multicord.mondomaine.fr (enregistrement DNS A vers l'IP du VPS)
#  - sans nom de domaine : l'IP du VPS avec des tirets + .sslip.io, ex. 203-0-113-10.sslip.io
DOMAIN=
# Adresse IP publique du VPS (pour le relais TURN)
PUBLIC_IP=

# Relais TURN des appels : mot de passe long et aléatoire (openssl rand -hex 24)
TURN_USERNAME=multicord
TURN_PASSWORD=

# Base de données — choisir UNE option :
# 1. Rien : SQLite dans le volume Docker (simple, convient à un groupe d'amis)
# 2. PostgreSQL sur le VPS (lancer avec --profile local-db) :
#    POSTGRES_PASSWORD=mot-de-passe-long
#    DATABASE_URL=postgresql://multicord:mot-de-passe-long@postgres:5432/multicord
# 3. PostgreSQL hébergé (Aiven, Supabase…) : l'URL fournie, et le certificat CA copié dans deploy/certs/
#    DATABASE_URL=postgres://...
#    DATABASE_SSL_CA_FILE=/app/certs/ca.pem
DATABASE_URL=
DATABASE_POOL_MAX=5

# E-mails (mot de passe oublié) — facultatif ; sans SMTP, ils restent dans le volume (data/mail)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Multicord <bonjour@mondomaine.fr>
